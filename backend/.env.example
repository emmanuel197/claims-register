# Copy to .env for local development.

DEBUG=True
SECRET_KEY=change-me

# Postgres only. Either the local docker-compose database ...
DATABASE_URL=postgresql://claims:claims@localhost:5432/claims
# ... or a Neon connection string (use the non-pooled host so the test runner can CREATE DATABASE):
# DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
